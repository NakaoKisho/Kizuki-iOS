{
  "hooks": {
    "SubagentStop": [
      {
        "matcher": "^(ios-tech-lead|user-advocate|ui-ux-designer|quality-engineer|data-privacy-specialist|delivery-engineer)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/skills/kizuki-agent-handoff/scripts/output_gate.py\" hook",
            "commandWindows": "py -3 -c \"import pathlib,runpy,subprocess; runpy.run_path(str(pathlib.Path(subprocess.check_output(['git','rev-parse','--show-toplevel'],text=True).strip()) / '.agents/skills/kizuki-agent-handoff/scripts/output_gate.py'),run_name='__main__')\" hook"
          }
        ]
      }
    ]
  }
}
